{
  "name": "Market Intelligence Pharma",
  "dataColors": [
    "#2563EB",
    "#98A2B3",
    "#0F9D8A",
    "#172B4D",
    "#F59E0B",
    "#7C9CF0",
    "#5EC4B6",
    "#D64545"
  ],
  "background": "#FFFFFF",
  "foreground": "#172033",
  "tableAccent": "#2563EB",
  "good": "#16A36A",
  "neutral": "#F59E0B",
  "bad": "#D64545",
  "maximum": "#2563EB",
  "center": "#DBEAFE",
  "minimum": "#F3F7FF",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#172033"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#172B4D"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#172033"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#667085"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 14,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#172B4D"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 8,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 92
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#172B4D"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 100,
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "showTitle": false
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9,
            "maxMarginFactor": 40
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "secShow": true
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 8,
            "color": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "bubbles": [
          {
            "bubbleSize": -10
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": true,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "rowPadding": 5,
            "outlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#172033"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#172033"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAFBFC"
              }
            }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "rowPadding": 5,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#172033"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 10,
            "right": 10
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "textSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#172033"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          {
            "outline": "None",
            "barShow": false
          }
        ],
        "dataLabels": [
          {
            "fontSize": 18,
            "color": {
              "solid": {
                "color": "#172033"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ]
      }
    },
    "decompositionTreeVisual": {
      "*": {
        "tree": [
          {
            "effectiveBarsPerLevel": 8
          }
        ]
      }
    }
  }
}