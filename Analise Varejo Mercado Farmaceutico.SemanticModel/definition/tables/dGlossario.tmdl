/// Glossário digitado (substitui a extração do PDF do relatório original).
table dGlossario
	lineageTag: a9e08cf3-b69e-b057-b11a-8d1669c111d5

	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00fec99b-dff5-8bbb-14dc-db7d15b141b2
		summarizeBy: none
		sourceColumn: Ordem

		annotation SummarizationSetBy = Automatic

	column Grupo
		dataType: string
		lineageTag: dcca8d66-721e-8f48-55de-69282d165bb4
		summarizeBy: none
		sourceColumn: Grupo

		annotation SummarizationSetBy = Automatic

	column Termo
		dataType: string
		lineageTag: 8271cede-fbaa-665a-ca92-9f56e473009a
		summarizeBy: none
		sourceColumn: Termo

		annotation SummarizationSetBy = Automatic

	column Definição
		dataType: string
		lineageTag: 0489bd31-faa3-41db-b1ea-e736a503ca27
		summarizeBy: none
		sourceColumn: Definição

		annotation SummarizationSetBy = Automatic

	partition dGlossario = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Ordem = Int64.Type, Grupo = text, Termo = text, Definição = text], {
				        {1, "Preços", "PF — Preço Fábrica", "Preço de venda da indústria, com ICMS de 18%."},
				        {2, "Preços", "PPP — Pharmacy Purchase Price", "Preço pelo qual a farmácia adquire o produto do distribuidor. Amostra de 7.000 farmácias."},
				        {3, "Preços", "CPP — Customer Purchase Price", "Preço pelo qual o consumidor adquire o produto na farmácia. Amostra de 35 bandeiras de rede físicas, 660 lojas independentes físicas e 44 sites de compras."},
				        {4, "Medicamentos", "Rx Genérico", "Medicamento de prescrição que comprovou bioequivalência frente a um medicamento de referência; em geral produzido após o fim da proteção patentária."},
				        {5, "Medicamentos", "Rx Promovido", "Medicamento de prescrição com desconto comercial inferior a 50% no PPP; normalmente promovido junto à classe médica."},
				        {6, "Medicamentos", "Rx Similar/Trade", "Produto com marca comercial que não é considerado genérico pela ANVISA; produtos de marca com mais de 50% de desconto comercial no PPP."},
				        {7, "Medicamentos", "MIP Marca, MIP Trade/Similar e MIP Genérico", "Medicamentos isentos de prescrição, separados pelo mesmo critério de marca, similar e genérico."},
				        {8, "Consumer Health", "PEC — Personal Care", "Cuidados pessoais: cabelos, higiene oral e mais de 100 outras categorias."},
				        {9, "Consumer Health", "PAC — Patient Care", "Cuidados do paciente: tiras de glicemia, fraldas geriátricas, meias de compressão, curativos, medidores e testes."},
				        {10, "Consumer Health", "Nutricionais", "Nutrição infantil, adulta e geriátrica, fibras e alimentos especiais."},
				        {11, "Consumer Health", "OTC", "Categorias sem composto farmacêutico, como vitaminas até 100% da dose diária recomendada."},
				        {12, "Canais", "Independente", "Farmácias sem vínculo com rede, associação ou franquia."},
				        {13, "Canais", "Associativismo/Franquia", "Farmácias independentes reunidas em associações de compra ou franquias."},
				        {14, "Canais", "Redes", "Lojas pertencentes a redes de farmácias."},
				        {15, "Indicadores", "Share", "Venda da distribuidora dividida pela venda total do mercado (distribuidora + demais distribuidores) nos filtros aplicados."},
				        {16, "Indicadores", "Δ Share (p.p.)", "Diferença entre o share do período e o do período anterior equivalente, em pontos percentuais. De 8,2% para 9,1% são +0,9 p.p."},
				        {17, "Indicadores", "Período anterior", "Mesma quantidade de meses, imediatamente antes do período selecionado. Com MAT selecionado, é o MAT anterior."},
				        {18, "Indicadores", "MAT", "Moving Annual Total: os 12 meses terminados no último mês da base."},
				        {19, "Indicadores", "Market gap", "Mercado total menos a venda da distribuidora: o mercado que ela ainda não atende."},
				        {20, "Indicadores", "Índice de evolução", "(1 + crescimento da distribuidora) ÷ (1 + crescimento do mercado) × 100. Acima de 100, ganha share."},
				        {21, "Indicadores", "Potencial até o share médio", "Mercado da linha × (share de referência − share da linha). Quanto a distribuidora venderia a mais se tivesse ali o seu share médio."},
				        {22, "Indicadores", "Índice de penetração", "Share da linha ÷ share de referência × 100. Forte a partir de 120, fraco abaixo de 80."},
				        {23, "Indicadores", "Cobertura de estoque", "Estoque atual ÷ venda média mensal dos últimos 6 meses, em meses."}
				    })
				in
				    Fonte

	annotation PBI_ResultType = Table

