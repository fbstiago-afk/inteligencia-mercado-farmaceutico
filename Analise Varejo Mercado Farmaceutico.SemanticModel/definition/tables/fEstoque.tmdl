/// Foto de estoque de 03/04/2023 por UF e SKU, já ligada ao produto IQVIA pelo EAN.
table fEstoque
	lineageTag: c1801140-71eb-ce94-ce23-1e13c9005dfc

	column CD_ESTADO
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8bb11151-151e-2724-56ac-9b93c00f9505
		summarizeBy: none
		sourceColumn: CD_ESTADO

		annotation SummarizationSetBy = Automatic

	column SKU
		dataType: string
		lineageTag: 8a52739c-d08b-594a-3bc3-9a141b049903
		summarizeBy: none
		sourceColumn: SKU

		annotation SummarizationSetBy = Automatic

	column CD_FCC
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 34ba3bf7-c2f4-12ec-321e-cdc60d813179
		summarizeBy: none
		sourceColumn: CD_FCC

		annotation SummarizationSetBy = Automatic

	/// Descrição do item no mapa de estoque. Use para itens sem cadastro IQVIA.
	column 'Produto (estoque)'
		dataType: string
		lineageTag: ae3b4b1e-00b0-3516-8705-ac0eabd1b347
		summarizeBy: none
		sourceColumn: Produto (estoque)

		annotation SummarizationSetBy = Automatic

	column 'Laboratório (estoque)'
		dataType: string
		lineageTag: 9ee57b35-05fe-c3fb-2f31-11b00dba5c5f
		summarizeBy: none
		sourceColumn: Laboratório (estoque)

		annotation SummarizationSetBy = Automatic

	/// Cadastrado quando o EAN do item existe no catálogo IQVIA; caso contrário, Sem cadastro IQVIA.
	column 'Cadastro IQVIA'
		dataType: string
		lineageTag: 82edfcd2-2873-1e9e-2592-bebd9fc9b71a
		summarizeBy: none
		sourceColumn: Cadastro IQVIA

		annotation SummarizationSetBy = Automatic

	column Estoque
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: bf3bc696-087a-c824-c429-37c50e4f472e
		summarizeBy: sum
		sourceColumn: Estoque

		annotation SummarizationSetBy = Automatic

	partition fEstoque = m
		mode: import
		source =
				let
				    Fonte = fnLerCsv("fEstoque.csv"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"CD_ESTADO", Int64.Type}, {"SKU", type text}, {"CD_FCC", Int64.Type}, {"ProdutoEstoque", type text}, {"LaboratorioEstoque", type text}, {"CadastroIQVIA", type text}, {"Estoque", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"ProdutoEstoque", "Produto (estoque)"}, {"LaboratorioEstoque", "Laboratório (estoque)"}, {"CadastroIQVIA", "Cadastro IQVIA"}})
				in
				    Nomes

	annotation PBI_ResultType = Table

