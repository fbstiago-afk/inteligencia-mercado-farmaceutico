	/// Seta com o número de posições ganhas ou perdidas; ● novo quando não havia venda no período anterior.
	measure 'Indicador Ranking Laboratório' =
			VAR _r = [Ranking Laboratório]
			VAR _ra = [Ranking Laboratório Anterior]
			VAR _d = [Δ Ranking Laboratório]
			RETURN
			    SWITCH (
			        TRUE (),
