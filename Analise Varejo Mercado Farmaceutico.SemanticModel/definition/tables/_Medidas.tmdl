/// Tabela única de medidas, organizada em pastas de exibição.
table _Medidas
	lineageTag: ce4f0838-ec69-7fdb-48a0-520bb0ddb6d2

	/// Valor total do mercado (distribuidora Vitalis + demais distribuidores), a preço de referência (PR), no contexto de filtro atual.
	measure 'Venda Total Mercado' = SUM ( fVendas[Valor PR] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 00 Base
		lineageTag: 1c1e4507-9647-985a-2754-cd6e4ba90558

	/// Valor vendido pela Vitalis a preço de referência (PR).
	measure 'Venda Vitalis' = CALCULATE ( [Venda Total Mercado], dDistribuidor[Distribuidor] = "VITALIS" )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 00 Base
		lineageTag: b9695d9f-d1af-ee48-bb98-aae13f78732b

	/// Valor vendido pelos demais distribuidores a preço de referência (PR).
	measure 'Venda Outros' = CALCULATE ( [Venda Total Mercado], dDistribuidor[Distribuidor] = "OUTROS" )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 00 Base
		lineageTag: 1f1492b5-d4f2-f9e8-3e95-4da16fd1cd48

	/// Unidades vendidas no mercado total.
	measure 'Qtde Mercado' = SUM ( fVendas[Unidades] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 2156164b-b880-cfba-b97c-43c41ef10fee

	/// Unidades vendidas pela Vitalis.
	measure 'Qtde Vitalis' = CALCULATE ( [Qtde Mercado], dDistribuidor[Distribuidor] = "VITALIS" )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 48bda3c7-d9fc-da28-1e5b-cca9987b5ec0

	/// Unidades vendidas pelos demais distribuidores.
	measure 'Qtde Outros' = CALCULATE ( [Qtde Mercado], dDistribuidor[Distribuidor] = "OUTROS" )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: c343bf42-011d-0048-75aa-c55c5a07e349

	/// Valor total do mercado a preço de compra (PC). Base alternativa: cobre também não medicamentos, que não têm preço de referência.
	measure 'Venda Total Mercado (PC)' = SUM ( fVendas[Valor PC] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 00 Base
		lineageTag: 59d6e5ed-71dc-7e79-f38b-519f45928029

	/// Valor vendido pela Vitalis a preço de compra (PC).
	measure 'Venda Vitalis (PC)' = CALCULATE ( [Venda Total Mercado (PC)], dDistribuidor[Distribuidor] = "VITALIS" )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 00 Base
		lineageTag: 7980dfd3-f78a-3e57-eedc-4364573a06de

	/// Venda no período anterior equivalente: mesma quantidade de meses, imediatamente antes do período selecionado. Em branco quando a base não cobre o período anterior inteiro.
	measure 'Venda Vitalis PA' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			VAR _n = _max - _min + 1
			RETURN
			    IF (
			        _min - _n >= 1,
			        CALCULATE (
			            [Venda Vitalis],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - _n
			                && dCalendario[Mês Índice] <= _max - _n
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: ac9e9ccf-9611-dcdc-a718-feae9a2e87bd

	/// Variação em reais da venda frente ao período anterior equivalente.
	measure 'Δ Venda Vitalis R$' =
			VAR _atual = [Venda Vitalis]
			VAR _base = [Venda Vitalis PA]
			RETURN
			    IF ( NOT ISBLANK ( _base ), _atual - _base )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: b8fc36ca-254b-4fa1-3b58-fe973daeb62c

	/// Venda do último mês do período selecionado.
	measure 'Venda Vitalis Mês Atual' =
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    CALCULATE ( [Venda Vitalis], dCalendario[Mês Índice] = _max )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: 34df3bca-f343-ddb0-3b22-55ea3bf84b33

	/// Venda do mês imediatamente anterior ao último mês selecionado.
	measure 'Venda Vitalis Mês Anterior' =
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    CALCULATE ( [Venda Vitalis], REMOVEFILTERS ( dCalendario ), dCalendario[Mês Índice] = _max - 1 )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: 75ec479b-8da7-7681-4593-5b20d4affb20

	/// Variação em reais do último mês contra o mês anterior.
	measure 'MoM R$' =
			VAR _atual = [Venda Vitalis Mês Atual]
			VAR _base = [Venda Vitalis Mês Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _base ), _atual - _base )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: 2c17d51d-9fd0-844d-8277-2b46d72b5a35

	/// Variação percentual do último mês contra o mês anterior.
	measure 'MoM %' =
			VAR _atual = [Venda Vitalis Mês Atual]
			VAR _base = [Venda Vitalis Mês Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: b8f5d534-a29a-5df9-37a1-97f72a8d6f6c

	/// Venda no mesmo período do ano anterior (12 meses antes).
	measure 'Venda Vitalis LY' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    IF (
			        _min - 12 >= 1,
			        CALCULATE (
			            [Venda Vitalis],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - 12
			                && dCalendario[Mês Índice] <= _max - 12
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: aeae5d18-6486-b7d5-5979-63ac400df3e0

	/// Variação em reais contra o mesmo período do ano anterior.
	measure 'YoY R$' =
			VAR _atual = [Venda Vitalis]
			VAR _base = [Venda Vitalis LY]
			RETURN
			    IF ( NOT ISBLANK ( _base ), _atual - _base )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: e9d9c701-0d80-dd86-c016-eaf3f2197df6

	/// Variação percentual contra o mesmo período do ano anterior.
	measure 'YoY %' =
			VAR _atual = [Venda Vitalis]
			VAR _base = [Venda Vitalis LY]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: 89fcbecb-3ef8-115d-4bb4-99ae19ec7526

	/// Venda acumulada de janeiro até o último mês selecionado.
	measure 'Venda Vitalis YTD' =
			VAR _fim = MAX ( dCalendario[AnoMesNum] ) - 0
			VAR _ini = INT ( _fim / 100 ) * 100 + 1
			RETURN
			    CALCULATE (
			        [Venda Vitalis],
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[AnoMesNum] >= _ini
			            && dCalendario[AnoMesNum] <= _fim
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: 1416268b-a656-31ff-a7cd-1f04a3a9fe3a

	/// Venda acumulada no mesmo intervalo do ano anterior.
	measure 'Venda Vitalis YTD LY' =
			VAR _fim = MAX ( dCalendario[AnoMesNum] ) - 100
			VAR _ini = INT ( _fim / 100 ) * 100 + 1
			RETURN
			    CALCULATE (
			        [Venda Vitalis],
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[AnoMesNum] >= _ini
			            && dCalendario[AnoMesNum] <= _fim
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: 7b99a9e1-866f-dd21-a259-a94441ffae2a

	/// Diferença em reais entre o acumulado do ano e o acumulado do ano anterior.
	measure 'YTD Δ R$' =
			VAR _atual = [Venda Vitalis YTD]
			VAR _base = [Venda Vitalis YTD LY]
			RETURN
			    IF ( NOT ISBLANK ( _base ), _atual - _base )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: daae7dcd-0b01-9d91-f1ce-4407cb86633f

	/// Variação percentual do acumulado do ano contra o ano anterior.
	measure 'YTD Δ %' =
			VAR _atual = [Venda Vitalis YTD]
			VAR _base = [Venda Vitalis YTD LY]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: 25a45162-0228-a7f2-0ec3-e4ab11bd6567

	/// Média móvel de 3 meses da venda, terminando no último mês do contexto.
	measure 'Venda Vitalis MM3' =
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    IF (
			        _max >= 3,
			        DIVIDE (
			            CALCULATE (
			                [Venda Vitalis],
			                REMOVEFILTERS ( dCalendario ),
			                dCalendario[Mês Índice] >= _max - 2
			                    && dCalendario[Mês Índice] <= _max
			            ),
			            3
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 01 Receita
		lineageTag: c0ddfab6-1386-df06-4128-9538b550ec8b

	/// Mercado total no período anterior equivalente.
	measure 'Venda Mercado PA' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			VAR _n = _max - _min + 1
			RETURN
			    IF (
			        _min - _n >= 1,
			        CALCULATE (
			            [Venda Total Mercado],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - _n
			                && dCalendario[Mês Índice] <= _max - _n
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: a110b077-a05b-a5e1-1ead-0a6a8ee0ce1a

	/// Mercado total no mesmo período do ano anterior.
	measure 'Venda Mercado LY' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    IF (
			        _min - 12 >= 1,
			        CALCULATE (
			            [Venda Total Mercado],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - 12
			                && dCalendario[Mês Índice] <= _max - 12
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: d30d9935-c386-3674-9b1c-72e7a74c4ec3

	/// Média móvel de 3 meses do mercado total.
	measure 'Venda Mercado MM3' =
			VAR _max = MAX ( dCalendario[Mês Índice] )
			RETURN
			    IF (
			        _max >= 3,
			        DIVIDE (
			            CALCULATE (
			                [Venda Total Mercado],
			                REMOVEFILTERS ( dCalendario ),
			                dCalendario[Mês Índice] >= _max - 2
			                    && dCalendario[Mês Índice] <= _max
			            ),
			            3
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: ce2b47ca-fcf4-fbb3-e427-fa10552b2d70

	/// Tamanho do mercado ainda não atendido pela Vitalis: mercado total menos venda Vitalis.
	measure 'Market Gap' = [Venda Total Mercado] - [Venda Vitalis]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: 781cbe17-cbfa-b37a-0f67-f3ae8898c60f

	/// Venda incremental necessária para ganhar 1 ponto percentual de share no mercado atual.
	measure 'Potencial +1 p.p.' = [Venda Total Mercado] * 0.01
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: 011d5da5-6d9e-ab4c-dbc7-18e46f5e45b5

	/// Venda incremental necessária para ganhar 2 pontos percentuais de share no mercado atual.
	measure 'Potencial +2 p.p.' = [Venda Total Mercado] * 0.02
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: a4357b3b-65f2-f4cd-4837-2136a29bf95b

	/// Ganho de share (em p.p.) escolhido no parâmetro Meta Share. Padrão: 1 p.p.
	measure 'Meta Share p.p. Valor' = SELECTEDVALUE ( 'Meta Share'[Meta Share p.p.], 1 )
		formatString: #,0.0
		displayFolder: 02 Mercado
		lineageTag: 4af74772-73ab-8214-d4a7-7821e955914f

	/// Venda incremental necessária para ganhar o número de pontos percentuais escolhido no parâmetro Meta Share.
	measure 'Potencial Share Meta' = [Venda Total Mercado] * [Meta Share p.p. Valor] / 100
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02 Mercado
		lineageTag: 6605c355-d172-e751-ca17-124f9f8ad7ce

	/// Participação da venda Vitalis sobre a venda total do mercado (inclui a própria Vitalis) no contexto atual de filtro.
	measure 'Share Vitalis' = DIVIDE ( [Venda Vitalis], [Venda Total Mercado] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: 5b5d7c88-fd78-ff96-cce0-094d20f5e8f1

	/// Share no período anterior equivalente.
	measure 'Share Vitalis PA' = DIVIDE ( [Venda Vitalis PA], [Venda Mercado PA] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: 518b7000-fc27-9c3c-2411-b9f8fa52858c

	/// Variação do share frente ao período anterior equivalente, em pontos percentuais (não em %).
	measure 'Δ Share p.p.' =
			VAR _mercadoPA = [Venda Mercado PA]
			RETURN
			    IF (
			        NOT ISBLANK ( _mercadoPA ) && NOT ISBLANK ( [Venda Total Mercado] ),
			        ( [Share Vitalis] - [Share Vitalis PA] ) * 100
			    )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 03 Share
		lineageTag: 18767580-75fb-0adc-95b1-8916af1bd511

	/// Share no mesmo período do ano anterior.
	measure 'Share Vitalis LY' = DIVIDE ( [Venda Vitalis LY], [Venda Mercado LY] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: b8dafbf2-f99e-f377-63bb-166ae8da1dea

	/// Variação do share contra o mesmo período do ano anterior, em pontos percentuais.
	measure 'Δ Share YoY p.p.' =
			VAR _mercadoLY = [Venda Mercado LY]
			RETURN
			    IF ( NOT ISBLANK ( _mercadoLY ), ( [Share Vitalis] - [Share Vitalis LY] ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 03 Share
		lineageTag: 034493b7-e40a-8cad-405f-6350bb229500

	/// Share calculado sobre a média móvel de 3 meses (suaviza meses atípicos).
	measure 'Share Vitalis MM3' = DIVIDE ( [Venda Vitalis MM3], [Venda Mercado MM3] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: dbb6277c-589a-a585-0922-ea813f97530d

	/// Participação da Vitalis em unidades.
	measure 'Share Qtde Vitalis' = DIVIDE ( [Qtde Vitalis], [Qtde Mercado] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: 1716e79c-6ee5-c005-04e9-d6d2d377c876

	/// Share calculado a preço de compra (PC). Use para não medicamentos (PEC, PAC, Nutricionais, OTC).
	measure 'Share Vitalis (PC)' = DIVIDE ( [Venda Vitalis (PC)], [Venda Total Mercado (PC)] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: 8eaa732a-d089-1de0-1d96-af6a52c65483

	/// Cálculo usado no relatório de 2023: venda Vitalis dividida pela venda dos outros distribuidores. Mantida só para conciliação; não é participação de mercado.
	measure 'Razão Vitalis/Outros (legado)' = DIVIDE ( [Venda Vitalis], [Venda Outros] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Share
		lineageTag: 674fddef-71eb-203e-608b-cb22ace09adb

	/// Variação mínima de share (em p.p.) para classificar ganho ou perda. Abaixo disso, o status é Estável.
	measure 'Limiar Estabilidade p.p.' = 0.10
		formatString: 0.00
		displayFolder: 03 Share
		lineageTag: 2791f761-10f2-840f-b164-c1da64184850

	/// Classificação dinâmica pelo Δ Share p.p.: Ganhando share, Perdendo share, Estável (dentro do limiar), Novo (sem venda no período anterior) ou Sem base comparável.
	measure 'Status Share' =
			VAR _d = [Δ Share p.p.]
			VAR _v = [Venda Vitalis]
			VAR _vPA = [Venda Vitalis PA]
			VAR _mPA = [Venda Mercado PA]
			VAR _lim = [Limiar Estabilidade p.p.]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ) && ISBLANK ( _vPA ), BLANK (),
			        ISBLANK ( _mPA ), "Sem base comparável",
			        ISBLANK ( _vPA ) && _v > 0, "Novo",
			        _d >= _lim, "Ganhando share",
			        _d <= - _lim, "Perdendo share",
			        "Estável"
			    )
		displayFolder: 03 Share
		lineageTag: 76a35f8e-3dd3-5aeb-1c12-842f4cd1580a

	/// Share médio da Vitalis no período, nos estados e nos tipos de farmácia selecionados, considerando todos os produtos. É a régua contra a qual cada linha é comparada.
	measure 'Share Referência' = CALCULATE ( [Share Vitalis], REMOVEFILTERS ( dProduto ), ALLSELECTED ( dEstado ), ALLSELECTED ( dTipoFarmacia ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 09 Benchmark
		lineageTag: 106b7e38-2ece-e5aa-3e82-b7048f7d5309

	/// Unidades no período anterior equivalente.
	measure 'Qtde Vitalis PA' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			VAR _n = _max - _min + 1
			RETURN
			    IF (
			        _min - _n >= 1,
			        CALCULATE (
			            [Qtde Vitalis],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - _n
			                && dCalendario[Mês Índice] <= _max - _n
			        )
			    )
		formatString: #,0
		displayFolder: 04 Quantidade
		lineageTag: 679c8621-b37b-85ed-8b7c-cef63869abdb

	/// Unidades do mercado no período anterior equivalente.
	measure 'Qtde Mercado PA' =
			VAR _min = MIN ( dCalendario[Mês Índice] )
			VAR _max = MAX ( dCalendario[Mês Índice] )
			VAR _n = _max - _min + 1
			RETURN
			    IF (
			        _min - _n >= 1,
			        CALCULATE (
			            [Qtde Mercado],
			            REMOVEFILTERS ( dCalendario ),
			            dCalendario[Mês Índice] >= _min - _n
			                && dCalendario[Mês Índice] <= _max - _n
			        )
			    )
		formatString: #,0
		displayFolder: 04 Quantidade
		lineageTag: a0d75e86-2cc6-6ca8-4e3e-0bad19edaa0e

	/// Crescimento em unidades frente ao período anterior equivalente.
	measure 'Cresc. Qtde Vitalis %' =
			VAR _atual = [Qtde Vitalis]
			VAR _base = [Qtde Vitalis PA]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Quantidade
		lineageTag: 1216684b-07ec-6a96-1be9-3db93e0b7574

	/// Crescimento do mercado em unidades frente ao período anterior equivalente.
	measure 'Cresc. Qtde Mercado %' =
			VAR _atual = [Qtde Mercado]
			VAR _base = [Qtde Mercado PA]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Quantidade
		lineageTag: 498f53be-83f1-c593-0f3d-3ff6f3e49b39

	/// Crescimento da venda Vitalis frente ao período anterior equivalente.
	measure 'Cresc. Vitalis %' =
			VAR _atual = [Venda Vitalis]
			VAR _base = [Venda Vitalis PA]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Crescimento
		lineageTag: 60af008e-c886-501f-2995-e07044852f92

	/// Crescimento do mercado total frente ao período anterior equivalente.
	measure 'Cresc. Mercado %' =
			VAR _atual = [Venda Total Mercado]
			VAR _base = [Venda Mercado PA]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Crescimento
		lineageTag: d788c067-244e-89e1-6546-59a87570d078

	/// Crescimento do mercado contra o mesmo período do ano anterior.
	measure 'Mercado YoY %' =
			VAR _atual = [Venda Total Mercado]
			VAR _base = [Venda Mercado LY]
			RETURN
			    IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _atual - _base, _base ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Crescimento
		lineageTag: 7391e90b-becb-d1a5-143c-433a3de2c974

	/// (1 + crescimento Vitalis) ÷ (1 + crescimento do mercado) × 100. Acima de 100 a Vitalis cresce mais que o mercado e ganha share.
	measure 'Índice de Evolução' =
			VAR _cv = [Cresc. Vitalis %]
			VAR _cm = [Cresc. Mercado %]
			RETURN
			    IF ( NOT ISBLANK ( _cv ) && NOT ISBLANK ( _cm ), DIVIDE ( 1 + _cv, 1 + _cm ) * 100 )
		formatString: 0
		displayFolder: 05 Crescimento
		lineageTag: a8fa6584-f86e-9246-6b4a-1093deea60b6

	/// Posição na matriz crescimento do mercado × crescimento Vitalis.
	measure 'Quadrante de Crescimento' =
			VAR _cv = [Cresc. Vitalis %]
			VAR _cm = [Cresc. Mercado %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _cv ) || ISBLANK ( _cm ), BLANK (),
			        _cm >= 0 && _cv >= 0, "1 · Mercado cresce / Vitalis cresce",
			        _cm >= 0, "2 · Mercado cresce / Vitalis cai",
			        _cv >= 0, "3 · Mercado cai / Vitalis cresce",
			        "4 · Mercado cai / Vitalis cai"
			    )
		displayFolder: 05 Crescimento
		lineageTag: 0d29efc9-7beb-cc63-c4ae-b787b80afc52

	/// Compara a média dos últimos 3 meses com a média dos 3 meses anteriores: Alta acima de +5%, Queda abaixo de −5%, Estável entre os dois.
	measure Tendência =
			VAR _max = MAX ( dCalendario[Mês Índice] )
			VAR _recente =
			    CALCULATE ( [Venda Vitalis], REMOVEFILTERS ( dCalendario ), dCalendario[Mês Índice] >= _max - 2 && dCalendario[Mês Índice] <= _max )
			VAR _anterior =
			    CALCULATE ( [Venda Vitalis], REMOVEFILTERS ( dCalendario ), dCalendario[Mês Índice] >= _max - 5 && dCalendario[Mês Índice] <= _max - 3 )
			VAR _var = DIVIDE ( _recente - _anterior, _anterior )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _recente ) && ISBLANK ( _anterior ), BLANK (),
			        _max < 6 || ISBLANK ( _anterior ), "Sem base",
			        _var > 0.05, "Alta",
			        _var < -0.05, "Queda",
			        "Estável"
			    )
		displayFolder: 05 Crescimento
		lineageTag: f1af3da2-b210-f6a4-0f8b-4565a9078203

	/// Posição do produto por venda Vitalis, entre todos os itens que atendem aos filtros da página (não depende das outras colunas do visual).
	measure 'Ranking Produto' =
			VAR _valor = [Venda Vitalis]
			RETURN
			    IF (
			        HASONEVALUE ( dProduto[Produto · Laboratório] ) && NOT ISBLANK ( _valor ),
			        CALCULATE ( RANKX ( ALL ( dProduto[Produto · Laboratório] ), [Venda Vitalis], _valor, DESC, DENSE ), ALLSELECTED ( dProduto ) )
			    )
		formatString: 0
		displayFolder: 06 Ranking
		lineageTag: d44b8c06-53a7-a228-a08a-00da476ea53b

	/// Posição no período anterior equivalente.
	measure 'Ranking Produto Anterior' =
			VAR _valor = [Venda Vitalis PA]
			RETURN
			    IF (
			        HASONEVALUE ( dProduto[Produto · Laboratório] ) && NOT ISBLANK ( _valor ),
			        CALCULATE ( RANKX ( ALL ( dProduto[Produto · Laboratório] ), [Venda Vitalis PA], _valor, DESC, DENSE ), ALLSELECTED ( dProduto ) )
			    )
		formatString: 0
		displayFolder: 06 Ranking
		lineageTag: 25f5bf10-9892-ee81-217e-da5d92492fb1

	/// Posições ganhas (positivo) ou perdidas (negativo) frente ao período anterior.
	measure 'Δ Ranking Produto' =
			VAR _r = [Ranking Produto]
			VAR _ra = [Ranking Produto Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _r ) && NOT ISBLANK ( _ra ), _ra - _r )
		formatString: +0;-0;0
		displayFolder: 06 Ranking
		lineageTag: 06448282-d257-10e1-12b0-3e2e74bde8f2

	/// Seta com o número de posições ganhas ou perdidas; ● novo quando não havia venda no período anterior.
	measure 'Indicador Ranking Produto' =
			VAR _r = [Ranking Produto]
			VAR _ra = [Ranking Produto Anterior]
			VAR _d = [Δ Ranking Produto]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _r ), BLANK (),
			        ISBLANK ( _ra ), "● novo",
			        _d > 0, "▲ " & _d,
			        _d < 0, "▼ " & ABS ( _d ),
			        "▬"
			    )
		displayFolder: 06 Ranking
		lineageTag: 7878b62c-0cf5-8359-8078-a686fa067539

