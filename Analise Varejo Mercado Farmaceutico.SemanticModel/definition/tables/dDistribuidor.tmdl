/// VITALIS (empresa analisada) e OUTROS (demais distribuidores do mercado).
table dDistribuidor
	lineageTag: 7b1b29f9-4a7c-4b2b-c96e-d7e97850c2dc

	column CD_DISTRIBUIDOR
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 0a8cb33b-daf1-e4f7-7938-525efaa1d9ad
		summarizeBy: none
		sourceColumn: CD_DISTRIBUIDOR

		annotation SummarizationSetBy = Automatic

	column Distribuidor
		dataType: string
		lineageTag: ae047576-561f-ba45-1403-db924edb6b5c
		summarizeBy: none
		sourceColumn: Distribuidor

		annotation SummarizationSetBy = Automatic

	column 'Grupo Distribuidor'
		dataType: string
		lineageTag: 06bbf7ac-ce66-b072-2e7b-71a934d623b0
		summarizeBy: none
		sourceColumn: Grupo Distribuidor

		annotation SummarizationSetBy = Automatic

	partition dDistribuidor = m
		mode: import
		source =
				let
				    Fonte = fnLerCsv("dDistribuidor.csv"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"CD_DISTRIBUIDOR", Int64.Type}, {"Distribuidor", type text}, {"GrupoDistribuidor", type text}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"GrupoDistribuidor", "Grupo Distribuidor"}})
				in
				    Nomes

	annotation PBI_ResultType = Table

