model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados", "fnLerCsv", "fVendas", "fEstoque", "dCalendario", "dProduto", "dEstado", "dTipoFarmacia", "dDistribuidor", "dGlossario"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Medidas
ref table fVendas
ref table fEstoque
ref table dCalendario
ref table dProduto
ref table dEstado
ref table dTipoFarmacia
ref table dDistribuidor
ref table dGlossario
ref table 'Meta Share'
ref table 'Dimensão de Análise'
ref table Indicador

ref cultureInfo pt-BR

