/// Pasta dos arquivos CSV do projeto (terminar com barra invertida). Altere aqui se mover o projeto.
expression PastaDados = "C:\dados_portfolio\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: f693406e-3804-4c18-a469-dfdd2a308434

	annotation PBI_ResultType = Text

/// Lê um CSV UTF-8 separado por ponto e vírgula da PastaDados e promove o cabeçalho.
expression fnLerCsv =
		(arquivo as text) as table =>
		    let
		        Fonte = Csv.Document(File.Contents(PastaDados & arquivo), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		        Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true])
		    in
		        Cabecalho
	lineageTag: cb327fe5-7b9e-2c2b-d42a-edb5fed960cc

	annotation PBI_ResultType = Function

